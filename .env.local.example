# Copy this file to `.env.local` for local Payload testing.

# Required for Payload auth/session encryption in local development.
# Make this a long, random string in production.
# You can generate a secure secret with `openssl rand -base64 48
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# Local Postgres for Payload development. Replace this with a real Netlify
# Database connection string when testing against a linked Netlify site.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload

# Used by the custom Payload media adapter backed by Netlify Blobs.
NETLIFY_BLOBS_MEDIA_STORE=payload-media
